{
  "name": "template-teams-bot",
  "version": "1.1.0",
  "description": "Microsoft Teams Bot template using Azure Functions and Bot Framework SDK",
  "type": "module",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "vp pack",
    "watch": "vp pack --watch",
    "start": "func start",
    "prestart": "pnpm run build",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test run",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@azure/functions": "^4.16.5",
    "botbuilder": "^4.23.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@12.15.0"
}
