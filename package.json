{
  "name": "template-teams-bot",
  "version": "1.0.0",
  "description": "Microsoft Teams Bot template using Azure Functions and Bot Framework SDK",
  "main": "dist/index.cjs",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "vp pack",
    "watch": "vp pack --watch",
    "start": "func start",
    "prestart": "pnpm run build",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test run",
    "test:watch": "vp test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@azure/functions": "^4.12.0",
    "botbuilder": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.2",
    "vite-plus": "alpha",
    "vitest": "^4.1.2"
  }
}
