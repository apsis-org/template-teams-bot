{
  "name": "template-teams-bot",
  "version": "1.0.0",
  "description": "Microsoft Teams Bot template using Azure Functions and Bot Framework SDK",
  "main": "dist/index.cjs",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "vp pack",
    "watch": "vp pack --watch",
    "start": "func start",
    "prestart": "pnpm run build",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test run",
    "test:watch": "vp test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@azure/functions": "^4.12.0",
    "botbuilder": "^4.23.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.16",
    "vite-plus": "alpha",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.20.0",
      "follow-redirects": "^1.16.0",
      "form-data": "^4.0.6",
      "ws@^7.0.0": "^7.5.11",
      "ws@^8.0.0": "^8.21.0",
      "uuid@<11.1.1": "^11.1.1",
      "vite": "^8.0.16",
      "postcss": "^8.5.23",
      "nanoid@^3.0.0": "^3.3.18"
    }
  }
}
