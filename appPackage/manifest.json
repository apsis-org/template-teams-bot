{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.25/MicrosoftTeams.schema.json",
  "manifestVersion": "1.25",
  "version": "1.1.0",
  "id": "__TEAMS_APP_ID__",
  "developer": {
    "name": "Your Company",
    "websiteUrl": "https://example.com",
    "privacyUrl": "https://example.com/privacy-policy/",
    "termsOfUseUrl": "https://example.com/terms-of-service/"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Teams Bot__ENV_SUFFIX__",
    "full": "Teams Bot Template__ENV_SUFFIX__"
  },
  "description": {
    "short": "Teams bot template (for teams and group chats)",
    "full": "A Microsoft Teams bot template running on Azure Functions. Add it to a team channel or a group chat to use it (personal chats are not supported)."
  },
  "accentColor": "#FFFFFF",
  "bots": [
    {
      "botId": "__BOT_ID__",
      "scopes": ["team", "groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["team", "groupChat"],
          "commands": [
            {
              "title": "help",
              "description": "Shows the help"
            },
            {
              "title": "hello",
              "description": "Says hello"
            }
          ]
        }
      ]
    }
  ],
  "supportsChannelFeatures": "tier1",
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": []
}
