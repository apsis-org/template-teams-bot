{
  "permissions": {
    "allow": [
      "Read(.env.example)",
      "Read(**/*.tfvars.example)",
      "Read(local.settings.json.example)"
    ],
    "deny": [
      "Read(.env)",
      "Read(*.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep *.env*)",
      "Bash(sed *.env*)",
      "Bash(awk *.env*)",
      "Bash(vim *.env*)",
      "Bash(nano *.env*)",
      "Bash(bat *.env*)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfvars.json)",
      "Read(**/*.auto.tfvars)",
      "Read(**/*.auto.tfvars.json)",
      "Bash(cat *.tfvars)",
      "Bash(cat *.tfvars.json)",
      "Bash(cat *.auto.tfvars)",
      "Bash(cat *.auto.tfvars.json)",
      "Bash(head *.tfvars)",
      "Bash(head *.tfvars.json)",
      "Bash(head *.auto.tfvars)",
      "Bash(head *.auto.tfvars.json)",
      "Bash(tail *.tfvars)",
      "Bash(tail *.tfvars.json)",
      "Bash(tail *.auto.tfvars)",
      "Bash(tail *.auto.tfvars.json)",
      "Bash(less *.tfvars*)",
      "Bash(more *.tfvars*)",
      "Bash(grep *.tfvars*)",
      "Bash(sed *.tfvars*)",
      "Bash(awk *.tfvars*)",
      "Bash(vim *.tfvars*)",
      "Bash(nano *.tfvars*)",
      "Bash(bat *.tfvars*)",
      "Read(local.settings.json)",
      "Bash(cat local.settings.json)",
      "Bash(head local.settings.json)",
      "Bash(tail local.settings.json)",
      "Bash(less local.settings.json*)",
      "Bash(more local.settings.json*)",
      "Bash(grep local.settings.json*)",
      "Bash(sed local.settings.json*)",
      "Bash(awk local.settings.json*)",
      "Bash(vim local.settings.json*)",
      "Bash(nano local.settings.json*)",
      "Bash(bat local.settings.json*)"
    ]
  }
}
