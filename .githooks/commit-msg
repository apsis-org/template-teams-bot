#!/bin/sh
# When manifest.json is staged, bump its version automatically based on the commit message prefix.
# Follows Conventional Commits (the type is read from the first line only).
# feat!: / fix(scope)!: and other !-suffixed types, BREAKING CHANGE: in the body, major: / BREAKING: → major (1.0.0 → 2.0.0)
# feat: / feat(scope): / feature:                                                                → minor (1.0.0 → 1.1.0)
# anything else                                                                                  → patch (1.0.0 → 1.0.1)
# This version is the Teams app version, independent of the template version (managed by release-please).
# If the staged version already differs from HEAD (changed by hand), the bump is skipped.
#
# Note: by the time commit-msg runs, git has already snapshotted the index for the commit, so the
# `git add` below does not reach the commit being created. The post-commit hook folds the staged
# bump into that commit with `git commit --amend`.

MANIFEST="appPackage/manifest.json"

if ! git diff --cached --name-only | grep -q "^${MANIFEST}$"; then
  exit 0
fi

MSG=$(cat "$1")

# Version at HEAD (empty on the very first commit)
HEAD_VERSION=$(git show HEAD:"${MANIFEST}" 2>/dev/null | node -e "
  let d=''; process.stdin.on('data',c=>d+=c).on('end',()=>{
    try { process.stdout.write(JSON.parse(d).version); } catch { process.stdout.write(''); }
  });
")

# Staged version
STAGED_VERSION=$(git show :"${MANIFEST}" | node -e "
  let d=''; process.stdin.on('data',c=>d+=c).on('end',()=>{
    process.stdout.write(JSON.parse(d).version);
  });
")

# Skip if the version was changed by hand
if [ -n "${HEAD_VERSION}" ] && [ "${STAGED_VERSION}" != "${HEAD_VERSION}" ]; then
  echo "manifest.json version: ${STAGED_VERSION} (set manually, skipping automatic bump)"
  exit 0
fi

CURRENT="${STAGED_VERSION}"

SUBJECT=$(printf '%s\n' "$MSG" | head -n 1)

if printf '%s\n' "$SUBJECT" | grep -qiE "^((BREAKING|major)|[a-z]+(\([^)]*\))?!):" \
  || printf '%s\n' "$MSG" | grep -qE "^BREAKING[ -]CHANGE:"; then
  BUMP="major"
elif printf '%s\n' "$SUBJECT" | grep -qiE "^(feat|feature)(\([^)]*\))?:"; then
  BUMP="minor"
else
  BUMP="patch"
fi

NEW_VERSION=$(node -e "
const v = '${CURRENT}'.split('.').map(Number);
if ('${BUMP}' === 'major') { v[0]++; v[1] = 0; v[2] = 0; }
else if ('${BUMP}' === 'minor') { v[1]++; v[2] = 0; }
else { v[2]++; }
process.stdout.write(v.join('.'));
")

# Replace only the top-level \"version\" line so the file keeps its formatting
# (re-serializing with JSON.stringify would expand arrays and break the formatter check).
node -e "
const fs = require('fs');
const src = fs.readFileSync('${MANIFEST}', 'utf8');
const out = src.replace(/\"version\":\s*\"[^\"]*\"/, '\"version\": \"${NEW_VERSION}\"');
if (out === src) { console.error('manifest.json: \"version\" field not found'); process.exit(1); }
fs.writeFileSync('${MANIFEST}', out);
"

git add "${MANIFEST}"

echo "manifest.json version: ${CURRENT} → ${NEW_VERSION} (${BUMP})"
