#!/bin/sh
# When manifest.json is staged, bump its version automatically based on the commit message prefix.
# The same version is written to package.json so the two always stay in sync.
# Follows Conventional Commits (the type is read from the first line only).
# feat!: / fix(scope)!: and other !-suffixed types, BREAKING CHANGE: in the body, major: / BREAKING: → major (1.0.0 → 2.0.0)
# feat: / feat(scope): / feature:                                                                → minor (1.0.0 → 1.1.0)
# anything else                                                                                  → patch (1.0.0 → 1.0.1)
# If the staged version already differs from HEAD (changed by hand), the bump is skipped and
# package.json is synced to that version instead.
#
# Note: by the time commit-msg runs, git has already snapshotted the index for the commit, so the
# index update below does not reach the commit being created. The post-commit hook folds the staged
# bump into that commit with `git commit --amend`.

MANIFEST="appPackage/manifest.json"
PACKAGE="package.json"

# Replace only the first "version" line (the top-level one) so the file keeps its formatting
# (re-serializing with JSON.stringify would expand arrays and break the formatter check).
# The staged blob and the working-tree file are rewritten separately, so unrelated unstaged edits
# are neither swept into the commit nor lost.
replace_version() {
  node -e "
let d=''; process.stdin.on('data',c=>d+=c).on('end',()=>{
  const re = /\"version\":\s*\"[^\"]*\"/;
  if (!re.test(d)) { console.error('$1: \"version\" field not found'); process.exit(1); }
  process.stdout.write(d.replace(re, '\"version\": \"$2\"'));
});
"
}

set_version() {
  git show :"$1" > "$1.staged.tmp" \
    && replace_version "$1" "$2" < "$1.staged.tmp" > "$1.new.tmp" \
    && BLOB=$(git hash-object -w "$1.new.tmp") \
    && git update-index --cacheinfo "$(git ls-files -s "$1" | cut -d' ' -f1)" "${BLOB}" "$1" \
    && replace_version "$1" "$2" < "$1" > "$1.new.tmp" \
    && cat "$1.new.tmp" > "$1"
  STATUS=$?
  rm -f "$1.staged.tmp" "$1.new.tmp"
  [ "${STATUS}" -eq 0 ] || exit 1
}

if ! git diff --cached --name-only | grep -q "^${MANIFEST}$"; then
  exit 0
fi

MSG=$(cat "$1")

# Version at HEAD (empty on the very first commit)
HEAD_VERSION=$(git show HEAD:"${MANIFEST}" 2>/dev/null | node -e "
  let d=''; process.stdin.on('data',c=>d+=c).on('end',()=>{
    try { process.stdout.write(JSON.parse(d).version); } catch { process.stdout.write(''); }
  });
")

# Staged version
STAGED_VERSION=$(git show :"${MANIFEST}" | node -e "
  let d=''; process.stdin.on('data',c=>d+=c).on('end',()=>{
    process.stdout.write(JSON.parse(d).version);
  });
")

# Skip if the version was changed by hand
if [ -n "${HEAD_VERSION}" ] && [ "${STAGED_VERSION}" != "${HEAD_VERSION}" ]; then
  set_version "${PACKAGE}" "${STAGED_VERSION}"
  echo "manifest.json version: ${STAGED_VERSION} (set manually, skipping automatic bump; synced to package.json)"
  exit 0
fi

CURRENT="${STAGED_VERSION}"

SUBJECT=$(printf '%s\n' "$MSG" | head -n 1)

if printf '%s\n' "$SUBJECT" | grep -qiE "^((BREAKING|major)|[a-z]+(\([^)]*\))?!):" \
  || printf '%s\n' "$MSG" | grep -qE "^BREAKING[ -]CHANGE:"; then
  BUMP="major"
elif printf '%s\n' "$SUBJECT" | grep -qiE "^(feat|feature)(\([^)]*\))?:"; then
  BUMP="minor"
else
  BUMP="patch"
fi

NEW_VERSION=$(node -e "
const v = '${CURRENT}'.split('.').map(Number);
if ('${BUMP}' === 'major') { v[0]++; v[1] = 0; v[2] = 0; }
else if ('${BUMP}' === 'minor') { v[1]++; v[2] = 0; }
else { v[2]++; }
process.stdout.write(v.join('.'));
")

# package.json first: its version line is not validated earlier, so a failure there leaves nothing half-done
set_version "${PACKAGE}" "${NEW_VERSION}"
set_version "${MANIFEST}" "${NEW_VERSION}"

echo "manifest.json / package.json version: ${CURRENT} → ${NEW_VERSION} (${BUMP})"
