# Settings shared by stg and prod
# cp terraform.tfvars.example terraform.tfvars and edit the values
# Each environment directory references this file through a symbolic link

project_name          = "myteamsbot" # lowercase letters, digits, hyphens; 3-20 characters
subscription_id       = "00000000-0000-0000-0000-000000000000"
shared_key_vault_name = "kv-<org>-gh-actions" # organization-wide Key Vault holding the sp-github-actions credentials
